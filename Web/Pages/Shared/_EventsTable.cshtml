@model List<Application.DTO.EventDto>
@{

}

<h2>Список мероприятий</h2>

<div class="table">
    <div class="table__row table__title-row">
        <div class="table__cell table__cell--2">Название мероприятия</div>
        <div class="table__cell table__cell--3">Описание мероприятия</div>
        <div class="table__cell table__cell--1">Дата, время</div>
        <div class="table__cell table__cell--2">Место проведения</div>
        <div class="table__cell table__cell--1">Категория</div>
        <div class="table__cell table__cell--1">Количество участников</div>
        <div class="table__cell table__cell--1">Действия</div>
    </div>

    @foreach (var eventItem in Model)
    {
        <div class="table__row">
            <div class="table__cell table__cell--2">
                <a href="/Event/@eventItem.Id" class="event-title-link">@eventItem.Title</a>
            </div>
            <div class="table__cell table__cell--3">@eventItem.Description</div>
            <div class="table__cell table__cell--1">@eventItem.StartDateTime.ToString("g")</div>
            <div class="table__cell table__cell--2">@eventItem.Location</div>
            <div class="table__cell table__cell--1">@eventItem.Category</div>
            <div class="table__cell table__cell--1">@eventItem.Participants.Count/@eventItem.MaxParticipants</div>

            @if (User.IsInRole("Admin"))
            {
                <div class="table__cell table__cell--1">
                    <div class="table__btn-wrapper">
                        <button class="btn btn-info" onclick="openEditModal('@eventItem.Id')">Изменить</button>
                        <button class="btn btn-danger" onclick="deleteEvent('@eventItem.Id')">Удалить</button>
                    </div>
                </div>
            } else {
                <div class="table__cell table__cell--1">
                    <div class="table__btn-wrapper">
                        <button class="btn btn-info" onclick="registerParticipantForEvent('@eventItem.Id')">Записаться</button>
                    </div>
                </div>
            }
        </div>
    }
</div>


<script>
    async function deleteEvent(eventId) {
        const url = `/api/Events/${eventId}`;

        const response = await fetch(url, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            },
        });

        if (response.ok) {
            alert('Событие успешно удалено!');
            location.reload();
        } else {
            alert('Ошибка при удалении события!');
        }
    }
    
    async function registerParticipantForEvent(eventId) {
        const url = `/api/EventRegistration/${eventId}`;

        const response = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
        });

        if (response.ok) {
            alert('Успешная запись');
            location.reload();
        } else {
            alert('Ошибка при записи на событие!');
        }
    }
</script>