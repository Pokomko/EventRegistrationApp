@model List<Domain.Entities.Event>
@{

}

<h2>Список мероприятий</h2>

<table>
    <thead>
        <tr>
            <th><span>Название мероприятия</span></th>
            <th><span>Описание мероприятия</span></th>
            <th><span>Дата, время</span></th>
            <th><span>Место проведения</span></th>
            <th><span>Категория мероприятия</span></th>
            <th><span>Количество<br>участников</span></th>
            @if (User.IsInRole("Admin"))
            {
                <th><span>Действия</span></th>
            } else
            {
                <th><span>Действия</span></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var eventItem in Model)
        {
            <tr>
                <td>@eventItem.Title</td>
                <td>@eventItem.Description</td>
                <td>@eventItem.StartDateTime.ToString("g")</td>
                <td>@eventItem.Location</td>
                <td>@eventItem.Category</td>
                <td>@eventItem.MaxParticipants</td>

                @if (User.IsInRole("Admin"))
                {
                    <td>
                        <button class="btn btn-info" onclick="editEvent('@eventItem.Id')">Изменить</button>
                        <button class="btn btn-danger" onclick="deleteEvent('@eventItem.Id')">Удалить</button>
                    </td>
                } else
                {
                    <td>
                        <button class="btn btn-info" onclick="editEvent('@eventItem.Id')">Записаться</button>
                    </td>
                }

            </tr>
        }
    </tbody>
</table>

<script>
    async function deleteEvent(eventId) {
        const url = `/api/Events/${eventId}`;

        const response = await fetch(url, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            },
        });

        if (response.ok) {
            alert('Событие успешно удалено!');
            location.reload();
        } else {
            alert('Ошибка при удалении события!');
        }
    }

    async function editEvent(eventId) {
        const modal = document.getElementById("modalOverlay");
        const openBtn = document.getElementById("openModalBtn");
        const closeBtn = document.getElementById("closeModalBtn");

        openBtn?.addEventListener("click", () => {
            modal.style.display = "flex";
        });

        closeBtn?.addEventListener("click", () => {
            modal.style.display = "none";
        });

        window.addEventListener("click", (e) => {
            if (e.target === modal) {
                modal.style.display = "none";
            }
        });
    }
</script>