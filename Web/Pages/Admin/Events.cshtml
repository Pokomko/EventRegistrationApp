@page
@model Web.Pages.Admin.AdminModelIndex
@{
    Layout = "_Layout";
}
@section Styles {
    <link rel="stylesheet" href="../css/admin.css">
}

<a href="/Logout" class="logout-button">Выйти</a>

<h1>Welcome, @Model.UserName</h1>

@await Html.PartialAsync("_EventsTable", Model.Events)

<h2>Add New Event</h2>
<form method="post">
    @Html.AntiForgeryToken()

    <label for="EventTitle">Название мероприятия</label>
    <input name="EventTitle" type="text" id="EventTitle" required />

    <label for="EventDescription">Описание мероприятия</label>
    <input name="EventDescription" type="text" id="EventDescription" required />

    <label for="EventDate">Дата начала</label>
    <input name="EventDate" id="EventDate" type="datetime-local" required />

    <label for="EventLocation">Место проведения</label>
    <input name="EventLocation" type="text" id="EventLocation" required />

    <label for="EventCategory">Категория мероприятия</label>
    <input name="EventCategory" type="text" id="EventCategory" required />

    <label for="EventMaxParticipants">Макс. количество участрников</label>
    <input name="EventMaxParticipants" type="number" id="EventMaxParticipants" required />

    <button class="submit" type="submit">Submit</button>
</form>
