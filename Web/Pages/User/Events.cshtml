@page
@model Web.Pages.User.UserModelIndex
@{
	Layout = "_Layout";
	ViewData["Title"] = Model.IsAdmin ? "Admin - Manage Events" : "User - See Events";
}
@section Styles {
	<link rel="stylesheet" href="~/css/events.css"/>
}

<div class="event-header">
    <a href="/Logout" class="logout-button">Выйти</a>
</div>

<h1>@ViewData["Title"]</h1>

@if (Model.IsAdmin) {
    <div class="button-wrapper">
        <button id="openModalBtn" class="btn btn-primary" onclick="openCreateModal()">Добавить новое мероприятие</button>
    </div>
}

<div class="container">
    <form method="get" class="search-form">
        <input type="text" name="Q" value="@Model.Q" placeholder="Поиск мероприятий..." />

        <input type="date"
               name="StartDate"
               value="@(Model.StartDate?.ToString("yyyy-MM-dd") ?? "")"
               class="search__input search__input--date" />

        <input type="date"
               name="EndDate"
               value="@(Model.EndDate?.ToString("yyyy-MM-dd") ?? "")"
               class="search__input search__input--date" />

        <button type="submit">Найти</button>

        @if (!string.IsNullOrEmpty(Model.Q))
        {
            <a href="?page=1" class="reset-button">X</a>
        }
    </form>
</div>

@await Html.PartialAsync("_EventsTable", Model.Events)

<div class="pagination">
    @if (Model.CurrentPage > 1)
    {
        <a href="?pageNumber=@(Model.CurrentPage - 1)&Q=@Model.Q&StartDate=@Model.StartDate&EndDate=@Model.EndDate">Назад</a>
    }

    <span>Страница @Model.CurrentPage из @Model.TotalPages</span>

    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a href="?pageNumber=@(Model.CurrentPage + 1)&Q=@Model.Q&StartDate=@Model.StartDate&EndDate=@Model.EndDate">Вперед</a>
    }
</div>

@if (Model.IsAdmin){
    @await Html.PartialAsync("_eventModal")
}

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const modal = document.getElementById("modalOverlay");
        const form = document.getElementById("eventForm");
        const modalTitle = document.getElementById("modalTitle");
        const submitBtn = document.getElementById("submitBtn");
        const closeBtn = document.getElementById("closeModalBtn");

        window.openCreateModal = () => {
            const modal = document.getElementById("modalOverlay");
            const form = document.getElementById("eventForm");

            form.reset();
            form.querySelector("[name='id']").value = "";

            modal.querySelector("#modalTitle").textContent = "Добавить мероприятие";
            modal.querySelector("#submitBtn").textContent = "Создать";

            modal.dataset.mode = "create";

            modal.style.display = "flex";
        };

        window.openEditModal = async (eventId) => {
            const response = await fetch(`/api/Events/${eventId}`);
            if (!response.ok) {
                alert("Ошибка при получении данных о мероприятии!");
                return;
            }

            const eventData = await response.json();

            form.querySelector("[name='id']").value = eventData.id;
            form.querySelector("[name='title']").value = eventData.title;
            form.querySelector("[name='description']").value = eventData.description;

            const dt = new Date(eventData.startDateTime);
            const valueForInput = dt.toISOString().slice(0,16); // YYYY-MM-DDTHH:MM
            form.querySelector("[name='startDateTime']").value = valueForInput;

            form.querySelector("[name='location']").value = eventData.location;
            form.querySelector("[name='category']").value = eventData.category;
            form.querySelector("[name='maxParticipants']").value = eventData.maxParticipants;

            modalTitle.textContent = "Редактировать мероприятие";
            submitBtn.textContent = "Сохранить изменения";
            modal.dataset.mode = "edit";

            modal.style.display = "flex";
        };

        closeBtn?.addEventListener("click", () => {
            modal.style.display = "none";
        });

        window.addEventListener("click", (e) => {
            if (e.target === modal) {
                modal.style.display = "none";
            }
        });

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();

            const mode = modal.dataset.mode;
            const formData = new FormData(form);

            let method = "POST";
            if (mode === "edit") {
                method = "PUT";
                formData.append("id", form.querySelector("[name='id']").value);
            }

            const response = await fetch("/api/events", {
                method,
                body: formData
            });

            if (response.ok) {
                alert(mode === "edit" ? "Мероприятие обновлено!" : "Мероприятие создано!");
                modal.style.display = "none";
                location.reload();
            } else {
                const error = await response.text();
                alert("Ошибка: " + error);
            }
        });

        const imageInput = document.getElementById("imageInput");
        const imagePreview = document.getElementById("imagePreview");

        imageInput?.addEventListener("change", () => {
        const file = imageInput.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = e => {
                imagePreview.src = e.target.result;
                imagePreview.style.display = "block";
            };
            reader.readAsDataURL(file);
        } else {
            imagePreview.style.display = "none";
        }
        });
    });
</script>
